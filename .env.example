# Copia questo file in .env.local e compila con i valori reali.
# ATTENZIONE: le chiavi private (gateway di pagamento, ecc.) vanno usate
# SOLO lato backend/serverless. Qui restano solo i valori "pubblici".

VITE_INSTAGRAM_HANDLE=lagroaigiovani

# Basta l'Event ID pubblico (il numero nell'URL dell'evento Eventbrite)
# per attivare il bottone di checkout — vedi EventbriteCheckoutButton.tsx
VITE_EVENTBRITE_EVENT_ID=

# --- Lato backend (non esporre mai al client) ---
# PAYMENT_PROVIDER_SECRET_KEY=
