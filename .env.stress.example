# Lo stress test crea da solo un PostgreSQL temporaneo (solo socket Unix) e non
# si collega mai a Supabase: non servono chiavi. Tutti i valori sono opzionali.

# Cartella dei binari PostgreSQL se non sono nel PATH (es. Homebrew):
# LOADTEST_PG_BIN=/opt/homebrew/opt/postgresql@17/bin

LOADTEST_CAPACITY=100
LOADTEST_CAP_ATTEMPTS=150
LOADTEST_READ_ATTEMPTS=200
LOADTEST_STOCK_ATTEMPTS=50
LOADTEST_CLOSE_RACE_ORDERS=30
LOADTEST_CLOSE_RACE_ROUNDS=10

# Elenco separato da virgole: read,idempotency,stock,capacity,identities,close-race
LOADTEST_SCENARIOS=read,idempotency,stock,capacity,identities,close-race
