# Questo runner rifiuta qualunque host che non sia localhost/127.0.0.1.
LOADTEST_CONFIRM=LOCAL_SUPABASE_ONLY
LOADTEST_SUPABASE_URL=http://127.0.0.1:54321
LOADTEST_SUPABASE_ANON_KEY=
LOADTEST_SUPABASE_SERVICE_ROLE_KEY=

# Valori opzionali
LOADTEST_CAPACITY=150
LOADTEST_CAP_ATTEMPTS=200
LOADTEST_READ_ATTEMPTS=200
LOADTEST_STOCK_ATTEMPTS=50
LOADTEST_CLOSE_RACE_ORDERS=30
LOADTEST_CLOSE_RACE_ROUNDS=10

# Elenco separato da virgole: read,idempotency,stock,capacity,identities,close-race
LOADTEST_SCENARIOS=read,idempotency,stock,capacity,identities,close-race
