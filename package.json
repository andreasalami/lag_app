{
  "name": "lag-app",
  "private": true,
  "version": "0.1.0",
  "description": "L'Agro ai Giovani (LAG) - piattaforma self-service per l'evento: biglietti, social, pagamenti cashless, tornei.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "stress:orders": "node --env-file-if-exists=.env.stress.local scripts/stress/orders.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@zxing/browser": "^0.1.5",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
